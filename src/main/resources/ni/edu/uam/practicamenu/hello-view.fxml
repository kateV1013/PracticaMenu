<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.practicamenu.HelloController">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Archivo">
                    <MenuItem text="Nuevo" onAction="#nuevoProducto" accelerator="Ctrl+N"/>
                    <MenuItem text="Guardar" onAction="#guardarProducto" accelerator="Ctrl+G"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Salir" onAction="#salirAplicacion" accelerator="Ctrl+Q"/>
                </Menu>
                <Menu text="Producto">
                    <MenuItem text="Eliminar" onAction="#eliminarProducto"/>
                </Menu>
            </MenuBar>

            <ToolBar>
                <Button text="Nuevo" onAction="#nuevoProducto"/>
                <Button text="Guardar" onAction="#guardarProducto"/>
                <Button text="Eliminar" onAction="#eliminarProducto"/>
                <Button text="Salir" onAction="#salirAplicacion"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>

            <GridPane hgap="10.0" vgap="10.0">
                <Label text="Codigo" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="codigoField" promptText="P001" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Nombre" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="nombreField" promptText="Nombre del producto" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Categoria" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="categoriaField" promptText="Categoria" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Precio" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="precioField" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Existencia" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="existenciaField" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <TableView fx:id="productosTable" VBox.vgrow="ALWAYS">
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem text="Nuevo" onAction="#nuevoProducto"/>
                            <MenuItem text="Guardar" onAction="#guardarProducto"/>
                            <MenuItem text="Eliminar" onAction="#eliminarProducto"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
                <columns>
                    <TableColumn fx:id="codigoColumn" text="Codigo" prefWidth="120.0"/>
                    <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="240.0"/>
                    <TableColumn fx:id="categoriaColumn" text="Categoria" prefWidth="180.0"/>
                    <TableColumn fx:id="precioColumn" text="Precio" prefWidth="120.0"/>
                    <TableColumn fx:id="existenciaColumn" text="Existencia" prefWidth="120.0"/>
                </columns>
            </TableView>

            <HBox>
                <Label fx:id="resultadoLabel" text="Listo."/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
